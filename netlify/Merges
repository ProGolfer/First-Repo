      document.getElementById("dashboard-countdown-value").textContent = state.countdownValue;
      document.getElementById("dashboard-pulse-wrap").innerHTML = pulseMarkup(state);
      renderDashboardDraftStatus();
      document.getElementById("dashboard-announcement-wrap").innerHTML = announcementMarkup(state);
      document.getElementById("dashboard-journey-wrap").innerHTML = journeyMarkup(state.journey);
      document.getElementById("dashboard-primary-content").innerHTML = state.primary;
      document.getElementById("dashboard-progressive-area").innerHTML = state.progressive;
      document.getElementById("dashboard-money-content").innerHTML = state.money;
      content.querySelectorAll(".wow-unfold").forEach((el)=>{el.style.animation='none';void el.offsetWidth;el.style.animation='';});
      document.querySelectorAll("#dashboard [data-screen]").forEach((button)=>button.addEventListener("click",()=>openScreen(button.dataset.screen)));
    }

    const scenarioSelect = document.getElementById("scenario-select");

    scenarioSelect.addEventListener("change", () => {
      renderDashboardState(scenarioSelect.value);
      openScreen("dashboard");
    });

    refreshDashboardClock();
    setInterval(refreshDashboardClock, 30000);
    renderDashboardState(scenarioSelect.value);

