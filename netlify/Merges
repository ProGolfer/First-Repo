<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Money Game Central — Approved Studio + Live App</title>

  <style>
    :root {
      --bg: #06110d;
      --panel: #0c1d16;
      --panel-2: #10271d;
      --panel-3: #163225;
      --border: rgba(255, 255, 255, 0.09);
      --text: #f4fff7;
      --muted: #8da99a;
      --green: #35e978;
      --green-light: #35e978;
      --green-dark: #159447;
      --gold: #f4c85a;
      --danger: #ff6868;
      --radius: 20px;
      --shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at top right, rgba(53, 233, 120, 0.11), transparent 30%),
        var(--bg);
      color: var(--text);
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    button,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app-shell {
      display: grid;
      grid-template-columns: 290px 1fr;
      min-height: 100vh;
    }

    .studio-sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 22px 18px;
      background: rgba(5, 15, 11, 0.96);
      border-right: 1px solid var(--border);
    }

    .brand {
      padding: 8px 10px 24px;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 11px;
      border-radius: 999px;
      background: rgba(53, 233, 120, 0.12);
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .brand h1 {
      margin: 14px 0 4px;
      font-size: 22px;
      line-height: 1.1;
    }

    .brand p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .nav-section {
      margin-top: 18px;
    }

    .nav-label {
      padding: 0 10px 8px;
      color: #6f8d7e;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .nav-button {
      display: flex;
      align-items: center;
      width: 100%;
      gap: 11px;
      margin: 5px 0;
      padding: 12px 13px;
      border: 1px solid transparent;
      border-radius: 13px;
      background: transparent;
      color: #cfe3d7;
      text-align: left;
      transition: 0.2s ease;
    }

    .nav-button:hover {
      background: rgba(255, 255, 255, 0.045);
    }

    .nav-button.active {
      background: linear-gradient(
        135deg,
        rgba(53, 233, 120, 0.18),
        rgba(53, 233, 120, 0.06)
      );
      border-color: rgba(53, 233, 120, 0.24);
      color: var(--green);
    }

    .studio-main {
      min-width: 0;
      padding: 24px;
    }

    .studio-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 22px;
      padding: 16px 18px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: rgba(12, 29, 22, 0.76);
      backdrop-filter: blur(14px);
    }

    .studio-topbar h2 {
      margin: 0;
      font-size: 20px;
    }

    .studio-topbar p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .topbar-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .status-pill {
      padding: 9px 12px;
      border-radius: 999px;
      background: rgba(53, 233, 120, 0.12);
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
    }

    .launch-button {
      padding: 11px 15px;
      border: 0;
      border-radius: 12px;
      background: var(--green);
      color: #03240f;
      font-weight: 900;
    }

    .screen {
      display: none;
      animation: fadeIn 0.22s ease;
    }

    .screen.active {
      display: block;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(7px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .studio-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 18px;
    }

    .studio-card {
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: linear-gradient(
        145deg,
        rgba(16, 39, 29, 0.96),
        rgba(9, 24, 17, 0.96)
      );
      box-shadow: var(--shadow);
    }

    .studio-card h3 {
      margin: 0 0 5px;
      font-size: 17px;
    }

    .studio-card p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .mission-card {
      position: relative;
      overflow: hidden;
      min-height: 215px;
    }

    .mission-card::after {
      content: "⛳";
      position: absolute;
      right: 22px;
      bottom: -25px;
      font-size: 145px;
      opacity: 0.06;
      transform: rotate(-8deg);
    }

    .eyebrow {
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .mission-card h2 {
      max-width: 520px;
      margin: 15px 0 10px;
      font-size: clamp(28px, 4vw, 48px);
      line-height: 1.03;
    }

    .mission-card strong {
      color: var(--green);
    }

    .mission-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 22px;
    }

    .primary-button,
    .secondary-button {
      padding: 11px 14px;
      border-radius: 12px;
      font-weight: 850;
    }

    .primary-button {
      border: 0;
      background: var(--green);
      color: #03240f;
    }

    .secondary-button {
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
    }

    .system-list {
      display: grid;
      gap: 10px;
      margin-top: 16px;
    }

    .system-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 12px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.035);
    }

    .system-item span:last-child {
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
    }

    .preview-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 17px;
    }

    .preview-button {
      min-height: 104px;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.035);
      color: var(--text);
      text-align: left;
      transition: 0.2s ease;
    }

    .preview-button:hover {
      transform: translateY(-3px);
      border-color: rgba(53, 233, 120, 0.32);
      background: rgba(53, 233, 120, 0.07);
    }

    .preview-icon {
      display: block;
      margin-bottom: 11px;
      font-size: 24px;
    }

    .preview-button strong {
      display: block;
      margin-bottom: 4px;
    }

    .preview-button small {
      color: var(--muted);
    }

    .test-controls {
      display: grid;
      gap: 12px;
      margin-top: 17px;
    }

    .control-group label {
      display: block;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }

    .control-group select {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 11px;
      outline: none;
      background: #07150f;
      color: var(--text);
    }

    .progress-row {
      margin-top: 15px;
    }

    .progress-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 7px;
      font-size: 13px;
    }

    .progress-track {
      height: 9px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.07);
    }

    .progress-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--green-dark), var(--green));
    }

    .phone-wrap {
      display: grid;
      place-items: start center;
      padding: 6px 0 30px;
    }

    .phone {
      width: min(100%, 430px);
      min-height: 750px;
      overflow: hidden;
      border: 9px solid #16231d;
      border-radius: 42px;
      background: #07130e;
      box-shadow: 0 35px 80px rgba(0, 0, 0, 0.5);
    }

    .phone-notch {
      width: 120px;
      height: 25px;
      margin: 0 auto 4px;
      border-radius: 0 0 18px 18px;
      background: #16231d;
    }

    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 19px 12px;
    }

    .app-header h1 {
      margin: 0;
      font-size: 18px;
    }

    .app-header small {
      color: var(--muted);
    }

    .menu-button {
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--panel);
      color: var(--text);
      font-size: 20px;
    }

    .phone-content {
      padding: 10px 16px 24px;
    }

    .app-card {
      margin-bottom: 13px;
      padding: 17px;
      border: 1px solid var(--border);
      border-radius: 19px;
      background: linear-gradient(
        145deg,
        rgba(17, 46, 32, 0.98),
        rgba(9, 28, 19, 0.98)
      );
    }

    .app-card h3 {
      margin: 0 0 5px;
      font-size: 16px;
    }

    .app-card p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .dashboard-top-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.9fr;
      gap: 11px;
    }

    .register-card {
      min-height: 145px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background:
        linear-gradient(145deg, rgba(39, 197, 96, 0.28), rgba(9, 44, 25, 0.92));
    }

    .weather-card {
      min-height: 145px;
      text-align: center;
    }

    .weather-temp {
      margin-top: 9px;
      font-size: 31px;
      font-weight: 900;
    }

    .announcement-card {
      border-left: 4px solid var(--gold);
    }

    .money-card {
      min-height: 165px;
      background:
        radial-gradient(circle at top right, rgba(244, 200, 90, 0.16), transparent 45%),
        linear-gradient(145deg, #173427, #0b2117);
    }

    .money-card .money-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .live-badge {
      padding: 6px 9px;
      border-radius: 999px;
      background: rgba(53, 233, 120, 0.13);
      color: var(--green);
      font-size: 11px;
      font-weight: 900;
    }

    .app-action {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 14px;
      color: var(--green);
      font-size: 13px;
      font-weight: 850;
    }

    .team-player,
    .score-player,
    .standing-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 13px 0;
      border-bottom: 1px solid var(--border);
    }

    .team-player:last-child,
    .score-player:last-child,
    .standing-row:last-child {
      border-bottom: 0;
    }

    .captain {
      color: var(--green);
      font-size: 11px;
      font-weight: 850;
    }

    .score-controls {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .score-controls button {
      width: 34px;
      height: 34px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--panel-3);
      color: var(--text);
    }

    .score-controls strong {
      min-width: 20px;
      text-align: center;
      font-size: 18px;
    }

    .hole-header {
      text-align: center;
    }

    .hole-header h2 {
      margin: 4px 0;
      font-size: 25px;
    }

    .hole-navigation {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 10px;
    }

    .hole-navigation button {
      border: 0;
      background: transparent;
      color: var(--muted);
    }

    .running-totals {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
    }

    .total-box {
      padding: 13px 6px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.04);
      text-align: center;
    }

    .total-box small {
      display: block;
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 0.08em;
    }

    .total-box strong {
      display: block;
      margin-top: 4px;
      font-size: 21px;
    }

    .full-app-button {
      width: 100%;
      margin-top: 11px;
      padding: 14px;
      border: 0;
      border-radius: 13px;
      background: var(--green);
      color: #03240f;
      font-weight: 900;
    }

    .recap-hero {
      padding: 25px 16px;
      text-align: center;
      background:
        radial-gradient(circle at top, rgba(244, 200, 90, 0.2), transparent 55%),
        linear-gradient(145deg, #223520, #101e16);
    }

    .recap-trophy {
      font-size: 44px;
    }

    .recap-hero h2 {
      margin: 7px 0 4px;
      font-size: 28px;
    }

    .gold {
      color: var(--gold);
    }

    .empty-note {
      padding: 35px;
      border: 1px dashed var(--border);
      border-radius: 18px;
      color: var(--muted);
      text-align: center;
    }


    /* =========================================================
       v0.3 — Dashboard Reimagined
       North Star: every element supports the golfer's Saturday.
       ========================================================= */

    .dashboard-phone {
      background:
        radial-gradient(circle at 90% 2%, rgba(53, 233, 120, 0.12), transparent 28%),
        #07130e;
    }

    .saturday-hero {
      position: relative;
      overflow: hidden;
      margin-bottom: 13px;
      padding: 20px;
      border: 1px solid rgba(53, 233, 120, 0.18);
      border-radius: 22px;
      background:
        radial-gradient(circle at top right, rgba(53, 233, 120, 0.18), transparent 40%),
        linear-gradient(145deg, rgba(17, 49, 34, 0.98), rgba(7, 25, 17, 0.98));
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
    }

    .saturday-hero::after {
      content: "⛳";
      position: absolute;
      right: -8px;
      bottom: -26px;
      font-size: 104px;
      opacity: 0.055;
      transform: rotate(-10deg);
    }

    .saturday-date-row,
    .countdown-row,
    .dashboard-card-title,
    .team-summary-head,
    .submission-progress-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .saturday-kicker {
      color: var(--green);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .saturday-time {
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
    }

    .saturday-hero h2 {
      position: relative;
      z-index: 1;
      margin: 13px 0 5px;
      font-size: 28px;
      line-height: 1.08;
    }

    .saturday-hero p {
      position: relative;
      z-index: 1;
      margin: 0;
      color: #b9d0c3;
      font-size: 13px;
    }

    .countdown-row {
      position: relative;
      z-index: 1;
      margin-top: 17px;
      padding-top: 15px;
      border-top: 1px solid var(--border);
    }

    .countdown-copy small,
    .countdown-value small {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 750;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .countdown-copy strong,
    .countdown-value strong {
      display: block;
      margin-top: 3px;
      font-size: 15px;
    }

    .countdown-value {
      text-align: right;
    }

    .dashboard-state-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 10px;
      padding: 6px 9px;
      border-radius: 999px;
      background: rgba(53, 233, 120, 0.11);
      color: var(--green);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .dashboard-action-card {
      position: relative;
      overflow: hidden;
      min-height: 164px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .dashboard-action-card.register-state {
      border-color: rgba(53, 233, 120, 0.3);
      background:
        radial-gradient(circle at top right, rgba(53, 233, 120, 0.25), transparent 42%),
        linear-gradient(145deg, rgba(30, 111, 59, 0.82), rgba(8, 39, 23, 0.98));
      animation: premiumPulse 2.8s ease-in-out infinite;
    }

    .dashboard-action-card.team-state {
      background:
        radial-gradient(circle at top right, rgba(53, 233, 120, 0.17), transparent 44%),
        linear-gradient(145deg, #153b29, #0a2016);
    }

    .dashboard-action-card.waiting-state {
      background:
        radial-gradient(circle at top right, rgba(244, 200, 90, 0.14), transparent 45%),
        linear-gradient(145deg, #243526, #101f16);
    }

    @keyframes premiumPulse {
      0%, 100% { box-shadow: 0 0 0 rgba(53, 233, 120, 0); }
      50% { box-shadow: 0 0 28px rgba(53, 233, 120, 0.13); }
    }

    .dashboard-main-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      margin-top: 15px;
      padding: 13px 14px;
      border: 0;
      border-radius: 13px;
      background: var(--green);
      color: #03240f;
      font-weight: 950;
    }

    .dashboard-secondary-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 13px;
      color: var(--green);
      font-size: 12px;
      font-weight: 850;
    }

    .weather-icon-large {
      margin-top: 4px;
      font-size: 31px;
      animation: weatherFloat 3.2s ease-in-out infinite;
    }

    @keyframes weatherFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-4px); }
    }

    .weather-detail {
      margin-top: 7px;
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
    }

    .dashboard-section-label {
      margin: 18px 2px 9px;
      color: #6f8d7e;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .team-mini-list {
      display: grid;
      gap: 8px;
      margin-top: 14px;
    }

    .team-mini-player {
      display: flex;
      align-items: center;
      gap: 9px;
      color: #dcebe2;
      font-size: 12px;
    }

    .team-mini-avatar {
      display: grid;
      place-items: center;
      width: 27px;
      height: 27px;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--green);
      font-size: 10px;
      font-weight: 900;
    }

    .hole-progress-wrap {
      margin-top: 15px;
    }

    .hole-progress-track,
    .submission-progress-track {
      height: 8px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.07);
    }

    .hole-progress-fill,
    .submission-progress-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--green-dark), var(--green));
      transition: width 0.35s ease;
    }

    .hole-progress-copy {
      display: flex;
      justify-content: space-between;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: 11px;
    }

    .submission-progress-head {
      margin-bottom: 9px;
      font-size: 12px;
    }

    .submitted-team-list {
      display: grid;
      gap: 8px;
      margin-top: 13px;
    }

    .submitted-team {
      display: flex;
      justify-content: space-between;
      padding: 10px 11px;
      border-radius: 11px;
      background: rgba(255, 255, 255, 0.035);
      color: #d9e9df;
      font-size: 12px;
    }

    .submitted-team span:last-child {
      color: var(--green);
      font-weight: 800;
    }

    .official-dashboard-card {
      border-color: rgba(244, 200, 90, 0.23);
      background:
        radial-gradient(circle at top right, rgba(244, 200, 90, 0.2), transparent 45%),
        linear-gradient(145deg, #243821, #101e16);
      box-shadow: 0 18px 44px rgba(244, 200, 90, 0.06);
    }

    .winner-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 7px;
      margin-top: 14px;
    }

    .winner-mini {
      padding: 10px 5px;
      border: 1px solid rgba(244, 200, 90, 0.13);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.035);
      text-align: center;
    }

    .winner-mini small {
      display: block;
      color: var(--muted);
      font-size: 9px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .winner-mini strong {
      display: block;
      margin-top: 4px;
      color: var(--gold);
      font-size: 12px;
    }

    .dashboard-fade-in {
