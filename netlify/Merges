    function draftStatusStripMarkup(){
      const slot=currentSlot();
      const pickNumber=draftState.cursor+1;
      let cssClass="waiting";
      let label="Draft Status";
      let message="Registration Closed · Draft starts soon";
      let action="Watch Draft";
      let screen="draft-central";

      if(draftState.published){
        cssClass="published";
        const publishedTime=draftState.publishedAt
          ? draftState.publishedAt.toLocaleTimeString([], {hour:"numeric", minute:"2-digit"})
          : "Official";
        message=`Teams Published · ${publishedTime}`;
        action="View Teams";
        screen="my-team";
      } else if(draftState.status==="live" && slot){
        cssClass="live";
        message=`Team ${slot.team} is on the clock · Pick ${pickNumber}`;
        action="Watch Live";
      } else if(draftState.status==="paused"){
        cssClass="paused";
        message=`Draft Paused · Team ${slot?.team || "—"} has the next pick`;
        action="View Draft";
      } else if(draftState.status==="complete"){
        cssClass="live";
        message="Draft Complete · Waiting for teams to be published";
        action="Review Teams";
      }

      return `<div class="draft-status-strip ${cssClass}"><div class="draft-status-main"><div class="draft-status-label">${label}</div><div class="draft-status-message">${message}</div></div><button class="draft-status-action" type="button" onclick="openScreen('${screen}')">${action} →</button></div>`;
    }

    function renderDashboardDraftStatus(){
      const wrap=document.getElementById("dashboard-draft-status-wrap");
      if(wrap) wrap.innerHTML=draftStatusStripMarkup();
    }

    function pulseMarkup(state){ return `<div class="pulse-ribbon ${state.pulseClass}"><div class="pulse-ribbon-inner"><span class="pulse-dot"></span><div><div class="pulse-ribbon-label">Saturday Pulse · ${state.pulseLabel}</div><div class="pulse-ribbon-message">${state.pulseMessage}</div></div></div></div>`; }
    function announcementMarkup(state){ return `<div class="bulletin"><div class="bulletin-kicker">📢 Dashboard Announcement</div><h3>${state.announcementTitle}</h3><p class="bulletin-lead">${state.announcementLead}</p><div class="bulletin-list">${state.announcementItems.map(x=>`<div class="bulletin-item"><span>${x}</span></div>`).join("")}</div><div class="bulletin-action">View full announcement →</div></div>`; }
    function journeyMarkup(index){ const labels=["Registered","Teams","Playing","Recap"], icons=["✓","👥","🏌","🏆"]; return `<div class="journey" style="--journey-progress:${index*33.33}%"><div class="journey-head"><h3>Saturday Journey</h3><span>${labels[index]}</span></div><div class="journey-track"><div class="journey-line"><div class="journey-fill"></div></div>${labels.map((l,i)=>`<div class="journey-step ${i<index?'done':i===index?'current':''}"><div class="journey-node">${i<index?'✓':icons[i]}</div>${l}</div>`).join("")}</div></div>`; }

    function refreshDashboardClock() {
      const now = new Date();
      const time = now.toLocaleTimeString([], {
        hour: "numeric",
        minute: "2-digit"
      });
      const date = now.toLocaleDateString([], {
        weekday: "long",
        month: "long",
        day: "numeric"
      });

      document.getElementById("dashboard-current-time").textContent = time;
      document.getElementById("dashboard-day-label").textContent = date;
    }

    function renderDashboardState(stateName) {
      const state = dashboardStates[stateName] || dashboardStates["Hole 8"];
      const content = document.getElementById("dashboard-content");
      document.getElementById("dashboard-header-small").textContent = state.headerSmall;
      document.getElementById("dashboard-hero-copy").textContent = state.heroCopy;
