      .getElementById("save-hole-button")
      .addEventListener("click", () => {
        const button =
          document.getElementById("save-hole-button");

        button.textContent = `✓ Hole ${currentHole} Saved`;

        setTimeout(() => {
          button.textContent = `Save Hole ${currentHole}`;
