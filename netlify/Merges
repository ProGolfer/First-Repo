  <script>
    (function () {
      const liveHtmlBase64 = "";
      const frame = document.getElementById("live-production-frame");
      let liveLoaded = false;

      function loadLiveProductionApp() {
        if (!frame || liveLoaded) return;
        try {
          const binary = atob(liveHtmlBase64);
          const bytes = Uint8Array.from(binary, character => character.charCodeAt(0));
          frame.srcdoc = new TextDecoder("utf-8").decode(bytes);
          liveLoaded = true;
        } catch (error) {
          console.error("Unable to load the live production app:", error);
        }
      }

      document.querySelectorAll('[data-screen="live-production"]').forEach(button => {
        button.addEventListener("click", loadLiveProductionApp);
      });
    })();
  </script>

